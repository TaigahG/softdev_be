# Supabase Postgres connection string.
# Get this from: Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
#
# For a long-running FastAPI server, use the "Session" pooler (port 5432) or direct connection.
# For serverless deployments, use the "Transaction" pooler (port 6543).
#
# Example (session pooler):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase Storage — for resume and image file uploads.
# SUPABASE_URL is from Project Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — server-only, never expose to clients.
# SUPABASE_JWT_SECRET is from Project Settings -> API -> JWT Secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
RESUMES_BUCKET=resumes
IMAGES_BUCKET=images

# Anthropic API key for resume parsing (Claude).
ANTHROPIC_API_KEY=

# Stripe — candidate membership subscription.
# STRIPE_SECRET_KEY: Developers -> API keys -> Secret key (sk_test_... for dev).
# STRIPE_WEBHOOK_SECRET: from `stripe listen` for local dev, or Dashboard webhook
# endpoint signing secret in production. Different values!
# STRIPE_PRICE_ID: the recurring Price (price_...) of your membership product.
# STRIPE_SUCCESS_URL / STRIPE_CANCEL_URL: frontend routes shown after checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/membership/success
STRIPE_CANCEL_URL=http://localhost:3000/membership/cancel

# Seeding (optional) — used by scripts/seed_prod_employers_jobs.py and scripts/seed_candidates.py
SEED_EMAIL_PREFIX=seed-employer
SEED_EMAIL_SUFFIX=
# SEED_FORCE=1    # Uncomment to re-seed even if data already exists